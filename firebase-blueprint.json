{
  "entities": {
    "StaffMember": {
      "title": "StaffMember",
      "description": "Represents an invited user assigned as either STAFF or ADMIN.",
      "type": "object",
      "properties": {
        "adminUid": {
          "type": "string",
          "description": "UID of the administrator who created this record.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full display name.",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Login email address used for invitation and authentication.",
          "minLength": 3,
          "maxLength": 120
        },
        "department": {
          "type": "string",
          "description": "Subject or department.",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "description": "Assigned access role chosen during invite: STAFF or ADMIN.",
          "enum": ["STAFF", "ADMIN"]
        },
        "inviteStatus": {
          "type": "string",
          "description": "Current status of the email invitation.",
          "enum": ["INVITED", "ACTIVE"]
        },
        "pin": {
          "type": "string",
          "description": "Fixed random 4-digit numeric PIN assigned to the staff member for dashboard login.",
          "minLength": 4,
          "maxLength": 4,
          "pattern": "^[0-9]{4}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "adminUid",
        "name",
        "email",
        "department",
        "role",
        "inviteStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "Student": {
      "title": "Student",
      "description": "Represents a student whose weekly targets are tracked by assigned staff.",
      "type": "object",
      "properties": {
        "adminUid": {
          "type": "string",
          "description": "UID of the administrator who created the student.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Full name of the student.",
          "minLength": 1,
          "maxLength": 100
        },
        "yearGroup": {
          "type": "string",
          "description": "Cohort or year group of the student.",
          "minLength": 1,
          "maxLength": 40
        },
        "studentCode": {
          "type": "string",
          "description": "Student reference code.",
          "minLength": 1,
          "maxLength": 30
        },
        "mentorName": {
          "type": "string",
          "description": "Name of the student's mentor.",
          "minLength": 1,
          "maxLength": 100
        },
        "subjects": {
          "type": "array",
          "description": "Bounded list of up to 10 subjects."
        },
        "assignedStaffEmails": {
          "type": "array",
          "description": "Bounded list of up to 20 staff email addresses assigned to this student."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "adminUid",
        "name",
        "yearGroup",
        "studentCode",
        "subjects",
        "assignedStaffEmails",
        "createdAt",
        "updatedAt"
      ]
    },
    "Target": {
      "title": "Target",
      "description": "Represents a learning target within a student subject, tracked weekly with WT, PA, A, or NA.",
      "type": "object",
      "properties": {
        "adminUid": {
          "type": "string",
          "description": "UID of the administrator who created this target.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "description": "Document ID of the parent Student.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "description": "Student name.",
          "minLength": 1,
          "maxLength": 100
        },
        "subject": {
          "type": "string",
          "description": "Academic subject.",
          "minLength": 1,
          "maxLength": 80
        },
        "targetGroupId": {
          "type": "string",
          "description": "Optional group ID linking parent targets and sub-targets (e.g. 1.1, 1.2) under one title.",
          "minLength": 0,
          "maxLength": 100
        },
        "heading": {
          "type": "string",
          "description": "Optional bold heading for the target.",
          "minLength": 0,
          "maxLength": 100000
        },
        "title": {
          "type": "string",
          "description": "Target description body.",
          "minLength": 1,
          "maxLength": 100000
        },
        "challenge": {
          "type": "string",
          "description": "Optional challenge note shown after the description.",
          "minLength": 0,
          "maxLength": 100000
        },
        "suggestedStrategies": {
          "type": "string",
          "description": "Optional suggested strategies for the target.",
          "minLength": 0,
          "maxLength": 100000
        },
        "internalNote": {
          "type": "string",
          "description": "Optional internal note shown in red above the target description in Admin and Staff views only (excluded from exports).",
          "minLength": 0,
          "maxLength": 100000
        },
        "fontColor": {
          "type": "string",
          "description": "Font color for displaying the target.",
          "enum": ["black", "red", "blue"]
        },
        "trackingRequired": {
          "type": "boolean",
          "description": "Whether weekly tracking is enabled for this specific target."
        },
        "assignedStaffEmail": {
          "type": "string",
          "description": "Email of the staff member assigned to track this target, or 'none'.",
          "minLength": 3,
          "maxLength": 120
        },
        "assignedStaffName": {
          "type": "string",
          "description": "Name of the staff member assigned to this target.",
          "minLength": 1,
          "maxLength": 100
        },
        "subjectStaffEmail": {
          "type": "string",
          "description": "Email of the staff member responsible for tracking the student's subject.",
          "minLength": 3,
          "maxLength": 120
        },
        "term": {
          "type": "string",
          "description": "Academic term label, e.g. TERM 1, TERM 2, or TERM 3.",
          "minLength": 1,
          "maxLength": 40
        },
        "currentWeekStatus": {
          "type": "string",
          "description": "Weekly tracking status: UNTRACKED, WT, PA, A, or NA.",
          "enum": ["UNTRACKED", "WT", "PA", "A", "M", "NA"]
        },
        "currentWeekKey": {
          "type": "string",
          "description": "Week identifier.",
          "minLength": 1,
          "maxLength": 20
        },
        "progressScore": {
          "type": "integer",
          "description": "Progress bar percentage (0 to 100)."
        },
        "weeklyHistorySummary": {
          "type": "string",
          "description": "Compact history string.",
          "minLength": 0,
          "maxLength": 500
        },
        "lastTrackedByEmail": {
          "type": "string",
          "description": "Email of the user who last tracked this target.",
          "minLength": 1,
          "maxLength": 120
        },
        "deadlineDate": {
          "type": "string",
          "description": "ISO date string for the weekly deadline.",
          "minLength": 1,
          "maxLength": 30
        },
        "notes": {
          "type": "string",
          "description": "Optional notes.",
          "minLength": 0,
          "maxLength": 400
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "adminUid",
        "studentId",
        "studentName",
        "subject",
        "title",
        "trackingRequired",
        "assignedStaffEmail",
        "assignedStaffName",
        "subjectStaffEmail",
        "currentWeekStatus",
        "currentWeekKey",
        "progressScore",
        "weeklyHistorySummary",
        "lastTrackedByEmail",
        "deadlineDate",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "NotificationItem": {
      "title": "NotificationItem",
      "description": "Represents an email invitation, pending assignment alert, or approaching deadline notification.",
      "type": "object",
      "properties": {
        "adminUid": {
          "type": "string",
          "description": "UID of the administrator who issued the notification.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientEmail": {
          "type": "string",
          "format": "email",
          "description": "Email address of the recipient.",
          "minLength": 3,
          "maxLength": 120
        },
        "recipientName": {
          "type": "string",
          "description": "Name of the recipient.",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "description": "Notification category.",
          "enum": ["INVITATION", "PENDING_ASSIGNMENT", "APPROACHING_DEADLINE", "ADMIN_REMINDER"]
        },
        "title": {
          "type": "string",
          "description": "Headline of the notification.",
          "minLength": 1,
          "maxLength": 140
        },
        "message": {
          "type": "string",
          "description": "Notification message.",
          "minLength": 1,
          "maxLength": 400
        },
        "studentId": {
          "type": "string",
          "description": "Associated student ID or 'all'.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "description": "Associated student name.",
          "minLength": 1,
          "maxLength": 100
        },
        "subject": {
          "type": "string",
          "description": "Associated subject.",
          "minLength": 1,
          "maxLength": 80
        },
        "dueDate": {
          "type": "string",
          "description": "Deadline date string.",
          "minLength": 1,
          "maxLength": 30
        },
        "isRead": {
          "type": "boolean",
          "description": "Whether the recipient has read the notification."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "adminUid",
        "recipientEmail",
        "recipientName",
        "type",
        "title",
        "message",
        "studentId",
        "studentName",
        "subject",
        "dueDate",
        "isRead",
        "createdAt",
        "updatedAt"
      ]
    },
    "WeekScheduleConfig": {
      "title": "WeekScheduleConfig",
      "description": "Stores editable week number and Monday-Friday date setup.",
      "type": "object",
      "properties": {
        "baseWeekNumber": {
          "type": "integer",
          "description": "Configured active week number (1 to 520)."
        },
        "baseMondayIso": {
          "type": "string",
          "description": "Configured Monday start date in YYYY-MM-DD format.",
          "minLength": 8,
          "maxLength": 20
        },
        "baseFridayIso": {
          "type": "string",
          "description": "Configured Friday end date in YYYY-MM-DD format.",
          "minLength": 8,
          "maxLength": 20
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "baseWeekNumber",
        "baseMondayIso",
        "baseFridayIso",
        "updatedAt"
      ]
    },
    "AdminEmailGrant": {
      "title": "AdminEmailGrant",
      "description": "Email allowlist record written by an Admin when promoting a user to ADMIN role.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "Lowercased Google email address granted ADMIN role.",
          "minLength": 3,
          "maxLength": 120
        },
        "grantedByUid": {
          "type": "string",
          "description": "UID of the administrator who promoted this user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": ["email", "grantedByUid", "updatedAt"]
    }
  },
  "firestore": {
    "/staff/{staffId}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Stores users (auto-registered as STAFF on Google sign-in or invited by Admin) and their assigned role (STAFF or ADMIN)."
    },
    "/admin_emails/{emailId}": {
      "schema": { "$ref": "#/entities/AdminEmailGrant" },
      "description": "Lookup records for manually promoted administrators."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Stores student records and assigned staff emails."
    },
    "/targets/{targetId}": {
      "schema": { "$ref": "#/entities/Target" },
      "description": "Stores weekly learning targets and WT/PA/A/NA progress."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/NotificationItem" },
      "description": "Stores invitations, pending assignment alerts, and deadline reminders."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/WeekScheduleConfig" },
      "description": "Stores editable week number and Monday-Friday date setup."
    }
  }
}
